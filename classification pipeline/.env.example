# Copy to .env and fill in. Never commit .env.
OPENROUTER_API_KEY=

# Only needed for --db (reuse answers already imported into the team MySQL database).
# Same names as the importer; a read-only account with SELECT on jobs, job_analyses
# and analysis_runs is enough.
AVDB_HOST=127.0.0.1
AVDB_PORT=3306
AVDB_NAME=av_job_profiles
AVDB_USER=
AVDB_PASSWORD=

# Only needed for the optional MySQL container (docker compose up -d).
MYSQL_ROOT_PASSWORD=
MYSQL_PASSWORD=
