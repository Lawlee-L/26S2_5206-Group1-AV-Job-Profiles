# Copy to .env (next to docker-compose.yml) and change every password.
# .env is already in .gitignore — never commit it.

# MySQL root + importer/admin account
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_USER=avjobs
MYSQL_PASSWORD=change-me-importer

# Read-only account the Flask backend uses
BACKEND_DB_USER=av_backend
BACKEND_DB_PASSWORD=change-me-backend

# Port the website is served on (http://localhost:8080)
WEB_PORT=8080
# Host port for MySQL (bound to 127.0.0.1 only)
DB_HOST_PORT=3306

# Public URL(s) of the site, comma-separated (only matters if the API is called cross-origin)
CORS_ORIGINS=http://localhost:8080

# Where the images live and which tag to run
IMAGE_PREFIX=ghcr.io/lawlee-l/26s2_5206-group1-av-job-profiles
IMAGE_TAG=latest

# How often Watchtower checks for new images (seconds)
WATCHTOWER_POLL_INTERVAL=300

# --- Pipeline jobs -----------------------------------------------------------
# Azure Translator KEY 1 for the collector. Leave empty to be asked each run.
AZURE_TRANSLATOR_KEY=
# OpenRouter key for the classifier's model calls (paid).
OPENROUTER_API_KEY=
# always = use the newest image from GitHub; build = use your local files
JOB_PULL_POLICY=always
