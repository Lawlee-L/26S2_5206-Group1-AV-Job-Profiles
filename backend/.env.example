# Flask backend
API_HOST=127.0.0.1
API_PORT=5000
FLASK_DEBUG=true

# MySQL read-only connection
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=av_job_profiles
DB_USER=av_backend
DB_PASSWORD=replace-with-local-password
DB_CONNECT_TIMEOUT=5

# React/Vite development origin. Comma-separate additional origins if needed.
CORS_ORIGINS=http://localhost:5173
