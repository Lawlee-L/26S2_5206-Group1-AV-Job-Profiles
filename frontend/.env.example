# Frontend configuration template. Copy to frontend/.env for local development.
# Keep your configured .env private; this example contains no real credentials.
# VITE_* values are public in the browser bundle: NEVER put secrets here.

# API address: REQUIRED when the backend is not at the default local origin.
# OPTIONAL only for the default local setup (the code falls back to this origin).
# Use the backend origin only: no /api suffix and no trailing slash.
VITE_API_BASE_URL=http://127.0.0.1:5000

# Company logos: OPTIONAL. Leave blank to use website icons / initials.
# For Logo.dev, use only your CDN PUBLISHABLE pk_... key, never an sk_ secret.
VITE_LOGO_DEV_TOKEN=

# Docker / nginx deployment:
# The intended API base is empty so requests use same-origin /api/... URLs.
# Current main uses || fallback in both API modules, so a blank value ALONE
# still selects localhost:5000. Apply the nullish-fallback/build-argument steps
# in docs/integration/README.md section 5.1 before using the empty Docker base.
# Supply both VITE_* variables during the frontend IMAGE BUILD, then rebuild.
# Runtime container environment changes alone do not update compiled Vite JS.
# The frontend .env and root Docker .env are different files; Compose does not
# automatically forward this frontend template to its build stage.
